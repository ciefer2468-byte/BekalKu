<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAll"
            style="@style/Widget.BekalKu.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/chip_all" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCat0"
            style="@style/Widget.BekalKu.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_breakfast" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCat1"
            style="@style/Widget.BekalKu.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_lunch" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCat2"
            style="@style/Widget.BekalKu.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_dinner" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCat3"
            style="@style/Widget.BekalKu.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_snack" />
    </com.google.android.material.chip.ChipGroup>
</HorizontalScrollView>
