<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema utama: Material 3 (terang) dengan palet oranye BekalKu. -->
    <style name="Base.Theme.UAS_240170129_Muhammad_Raihann_Azhari" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/primary_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/error_red</item>
        <item name="android:colorBackground">@color/cream</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="materialButtonStyle">@style/Widget.BekalKu.Button</item>
    </style>

    <style name="Theme.UAS_240170129_Muhammad_Raihann_Azhari" parent="Base.Theme.UAS_240170129_Muhammad_Raihann_Azhari" />

    <!-- Tombol -->
    <style name="Widget.BekalKu.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="Widget.BekalKu.Button.White" parent="Widget.BekalKu.Button">
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
    </style>

    <style name="Widget.BekalKu.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Chip filter kategori -->
    <style name="Widget.BekalKu.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="android:textSize">13sp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BekalKu.Pill</item>
    </style>

    <style name="ShapeAppearance.BekalKu.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Field teks -->
    <style name="Widget.BekalKu.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxBackgroundMode">outline</item>
    </style>

    <style name="Widget.BekalKu.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- Indikator aktif bottom navigation -->
    <style name="Widget.BekalKu.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
    </style>
</resources>
